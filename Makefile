# Xerxes Pi Admin Backend
#
#   make            build ./xerxes_backend (native)
#   make static     build a fully static binary (runs on any arm64 Linux)
#   make bundle     build xerxes_install.sh — a single self-extracting script
#                   containing src/ include/ public/ that compiles itself on
#                   the target. Paste it into any terminal and run it.
#   make test       build and run tests/test_utils.cpp and tests/test_newt.cpp
#   make clean
#
# Cross-compile:  make CXX=aarch64-linux-gnu-g++ TARGET=xerxes_backend_arm64

CXX      ?= g++
CXXFLAGS ?= -std=c++17 -O2 -Wall -Iinclude
LDFLAGS  ?= -lpthread -lcurl
TARGET   ?= xerxes_backend

SRCS := $(wildcard src/*.cpp)
OBJS := $(patsubst src/%.cpp,build/%.o,$(SRCS))

# Embedded assets: every file under public/ is compiled into the binary at
# build time so a stripped deployment can serve the frontend without the
# public/ directory present. Regenerated by make whenever public/ changes.
PUBLIC_FILES := $(shell find public -type f)
EMBED_CPP    := build/embedded_assets.cpp
EMBED_OBJ    := build/embedded_assets.o

# Debian packaging (make deb)
DEB_NAME    ?= xerxes-pi
DEB_VERSION ?= 0.2.0
DEB_ARCH    ?= $(shell dpkg --print-architecture 2>/dev/null || echo arm64)
DEB_DIR     := build/deb/$(DEB_NAME)_$(DEB_VERSION)_$(DEB_ARCH)

.PHONY: all static bundle test clean deb

all: $(TARGET)

$(TARGET): $(OBJS) $(EMBED_OBJ)
	$(CXX) $(CXXFLAGS) -o $@ $^ $(LDFLAGS)

build/%.o: src/%.cpp | build
	$(CXX) $(CXXFLAGS) -c -o $@ $<

# Generate the embedded-assets translation unit from the current public/ tree.
$(EMBED_CPP): $(PUBLIC_FILES) tools/gen_embedded_assets.sh | build
	tools/gen_embedded_assets.sh public build

$(EMBED_OBJ): $(EMBED_CPP)
	$(CXX) $(CXXFLAGS) -c -o $@ $<

build:
	mkdir -p build

static:
	$(MAKE) clean
	$(MAKE) LDFLAGS="-static-libgcc -static-libstdc++ -lpthread -lcurl" TARGET=$(TARGET)

# Debian package: wraps the static binary so it installs to
# /usr/local/bin/xerxes_backend with no runtime dependencies.
# Produces build/deb/$(DEB_NAME)_$(DEB_VERSION)_$(DEB_ARCH).deb
deb: static
	rm -rf $(DEB_DIR)
	mkdir -p $(DEB_DIR)/usr/local/bin $(DEB_DIR)/DEBIAN
	cp $(TARGET) $(DEB_DIR)/usr/local/bin/xerxes_backend
	sed -e 's/@VERSION@/$(DEB_VERSION)/g' -e 's/@ARCH@/$(DEB_ARCH)/g' \
	    packaging/control.in > $(DEB_DIR)/DEBIAN/control
	dpkg-deb --build --root-owner-group $(DEB_DIR)
	@echo "Wrote $(DEB_DIR).deb"

# Single-file installer: shell stub + base64 tarball of the source tree.
bundle: xerxes_install.sh

xerxes_install.sh: bundle_stub.sh $(SRCS) $(wildcard include/*.h) $(wildcard public/*)
	cat bundle_stub.sh > $@
	echo "__PAYLOAD__" >> $@
	tar czf - src include public | base64 -w0 >> $@
	echo "" >> $@
	chmod +x $@
	@echo "Wrote $@ ($$(wc -c < $@) bytes). Paste it into a terminal and run: bash xerxes_install.sh"

test: build/test_utils build/test_newt
	./build/test_utils
	./build/test_newt

build/test_utils: tests/test_utils.cpp src/utils.cpp | build
	$(CXX) $(CXXFLAGS) -o $@ $^ $(LDFLAGS)

build/test_newt: tests/test_newt.cpp src/newt_manager.cpp | build
	$(CXX) $(CXXFLAGS) -o $@ $^ $(LDFLAGS)

LLAMA_DIR        := third_party/llama.cpp
LLAMA_SERVER_BIN := $(LLAMA_DIR)/build/bin/llama-server

.PHONY: llama

llama: $(LLAMA_SERVER_BIN)

$(LLAMA_SERVER_BIN):
	cmake -B $(LLAMA_DIR)/build -S $(LLAMA_DIR) -DCMAKE_BUILD_TYPE=Release
	cmake --build $(LLAMA_DIR)/build -j1 --target llama-server

clean:
	rm -rf build $(TARGET) xerxes_install.sh

